# LLM Configuration (Optional: for extracting complex papers and enriching explanations)
# Set LLM_PROVIDER to "anthropic" or "openai" (leave "none" for deterministic regex extraction)
LLM_PROVIDER=none
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=

# Optional: custom base URL if using an OpenAI-compatible proxy/endpoint
# LLM_BASE_URL=https://api.openai.com/v1

# Verification tolerance in percentage points (default: 1.0)
TOLERANCE_PP=1.0

# Timeouts in seconds
RUN_TIMEOUT_S=300
SETUP_TIMEOUT_S=900
